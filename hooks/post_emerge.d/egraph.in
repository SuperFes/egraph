#!/bin/sh
# Brings egraph's store up to date after an emerge changed the installed packages, so that the
# next query does not pay for the refresh. portage passes its roots in the environment.

set -- --root "${ROOT:-/}" --config-root "${PORTAGE_CONFIGROOT:-/}"
if [ -n "$EPREFIX" ]; then
    set -- "$@" --eprefix "$EPREFIX"
fi
exec "${EGRAPH:-@BINDIR@/egraph}" "$@" refresh
