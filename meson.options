option(
  'portage_lib',
  type: 'string',
  value: '',
  description: 'portage lib/ directory the builder and its tests import in the build directory; '
  + 'empty uses the installed portage',
)
option(
  'portage_test_keys',
  type: 'string',
  value: '',
  description: 'A portage checkout\'s test GPG keys, which the playground tests need and an '
  + 'installed portage lacks; empty uses those of the portage under test, and without any the '
  + 'playground tests are skipped',
)
option(
  'portage_hooks',
  type: 'boolean',
  value: true,
  description: 'Install portage hooks that refresh the stores after each emerge and sync: '
  + 'egraph in /etc/portage/post_emerge.d and /etc/portage/postsync.d, and the dispatcher '
  + 'for post_emerge.d in ${datadir}/egraph, to link as /etc/portage/bin/post_emerge',
)
option(
  'portage_config',
  type: 'string',
  value: '/etc/portage',
  description: 'Where portage reads its configuration, and the hooks go: ${EPREFIX}/etc/portage',
)
option(
  'tui',
  type: 'feature',
  value: 'auto',
  description: 'The terminal interface (egraph tui), which needs Notcurses',
)
